# App
APP_NAME=PayDawg
APP_ENV=development
DATABASE_URL=sqlite:///./paydawg.db
DEMO_MODE=true
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Risk rules: tune for synthetic demo data; not production thresholds
DUPLICATE_WINDOW_SECONDS=300
VELOCITY_WINDOW_SECONDS=300
VELOCITY_MAX_PAYMENTS=5
AMOUNT_OUTLIER_MULTIPLIER=4
MIN_BASELINE_SAMPLES=3

# Optional LLM (uses OpenAI if configured; otherwise rules-only)
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=8

# Optional PayPal Sandbox. Keep demo mode enabled until all lifecycle flows are verified.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENABLED=false
