# Safe local default. Mock rail is SIMULATED and never moves real money.
# PAYPAL_MODE is mock or paypal. paypal = the real PayPal SANDBOX (needs the credentials below; set an ADMIN_TOKEN too).
DATABASE_PATH=paydawg.sqlite3
PAYPAL_MODE=mock

# Sandbox only. Never commit credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Where buyers can reach this server (PayPal sends them back to PUBLIC_BASE_URL/paypal/return).
# Set it to your real https address when deployed.
PUBLIC_BASE_URL=http://localhost:8000
# Where Dawg's page after PayPal links back to ("Back to the shop"). Empty hides the link.
SHOP_URL=/shop

# Optional. When set, the merchant console (list, details, approve, void, demo reset) needs this token
# (header X-Admin-Token). Strongly recommended for any deployment others can reach.
ADMIN_TOKEN=

# none | ollama | http_api. The AI can ask for a review (Growl) but can never block a payment.
LLM_PROVIDER=none
LLM_TIMEOUT_SECONDS=10
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2
LLM_HTTP_API_URL=
LLM_HTTP_API_KEY=
LLM_HTTP_API_MODEL=

# IANA timezone for the odd-hour rule and the hours Dawg learns, e.g. Asia/Kolkata. Empty = the server's local time.
MERCHANT_TIMEZONE=

# Duplicate = same customer + amount + order_ref inside this window (seconds).
DUPLICATE_WINDOW_SECONDS=120
# Payments per customer inside the velocity window before a hard block.
VELOCITY_LIMIT=5
VELOCITY_WINDOW_MINUTES=10
# Payments from the whole shop inside the window that raise a soft surge flag, for a brand-new shop.
# Dawg raises it as he learns the shop's busiest normal 10 minutes (never below this).
MERCHANT_SURGE_LIMIT=15
LARGE_AMOUNT_MULTIPLE=5
# Any single payment above this is held for review (Growl), even for a brand-new shop. 0 turns it off.
HARD_REVIEW_AMOUNT=500

# Demo shop: refuse placeholder emails (example.com, test domains) and throwaway-mail sites. Set to false to allow any address.
BLOCK_FAKE_EMAILS=true

# PayPal mode. after_approval: a Bark buyer still sees PayPal's approve screen, then Dawg stops the payment
# (nothing is authorized or captured, so no money moves). before_paypal: a Bark never reaches PayPal.
BARK_STAGE=after_approval

# Too many payment attempts tire the Dawg: attempts allowed per window, then a lockdown (HTTP 429).
# Set RATE_LIMIT_ATTEMPTS=0 to turn the limiter off.
RATE_LIMIT_ATTEMPTS=12
RATE_LIMIT_WINDOW_SECONDS=10
RATE_LIMIT_LOCK_SECONDS=15
# Shop-wide ceiling so a client forging X-Forwarded-For cannot buy itself unlimited quota. 0 disables.
RATE_LIMIT_GLOBAL_ATTEMPTS=120
# Only true when a proxy YOU control sets X-Forwarded-For. Anyone can forge that header.
TRUST_PROXY_HEADERS=false
