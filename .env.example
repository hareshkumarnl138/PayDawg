# Safe local default. Mock rail is SIMULATED and never moves real money.
APP_ENV=development
DATABASE_PATH=paydawg.sqlite3
PAYPAL_MODE=mock

# Sandbox only: fill these from a PayPal Developer sandbox app to use the real sandbox adapter.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# none | ollama | http_api
LLM_PROVIDER=none
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2
LLM_HTTP_API_URL=
LLM_HTTP_API_KEY=
LLM_HTTP_API_MODEL=

DUPLICATE_WINDOW_MINUTES=10
VELOCITY_LIMIT=5
VELOCITY_WINDOW_MINUTES=10
LARGE_AMOUNT_MULTIPLE=3
ODD_HOUR_START=1
ODD_HOUR_END=5
DEMO_SEED=true
